{
  "schemaVersion": 1,
  "id": "playermob",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://github.com/bh679/playermob-mc",
    "sources": "https://github.com/bh679/playermob-mc",
    "issues": "https://github.com/bh679/playermob-mc/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["games.brennan.playermob.fabric.PlayerMobFabric"],
    "client": ["games.brennan.playermob.fabric.client.PlayerMobFabricClient"]
  },
  "mixins": [
    "playermob.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_min}",
    "fabric-api": "*"
  }
}
